{
  "name": "bosun-x",
  "version": "0.2.0",
  "description": "A self-hosted dashboard for everything your AI agents are working on, plus the CLI and MCP server they use to hand off work. Plain files, one lock, agent-agnostic.",
  "type": "module",
  "bin": {
    "bosun-x": "cli.mjs",
    "bosun": "cli.mjs",
    "bosun-mcp": "mcp/server.mjs"
  },
  "files": [
    "cli.mjs",
    "lib/",
    "mcp/",
    "skill/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "mcp": "node mcp/server.mjs",
    "test": "node test/run.mjs"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "handoff",
    "claude-code",
    "codex",
    "context",
    "task-tracking",
    "cli",
    "dashboard",
    "self-hosted"
  ],
  "license": "MIT",
  "homepage": "https://x-hakt.com/locker/bosun-x",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-hakt/bosun-x.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.24.0"
  }
}
